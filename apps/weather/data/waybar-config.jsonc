// Example Waybar module configuration for Nyx Weather.
// Add "custom/weather" to modules-right (or modules-center) in ~/.config/waybar/config.jsonc
// and include the block below.
{
  "custom/weather": {
    "exec": "nyx-weather --waybar",
    "return-type": "json",
    "interval": 900,
    "on-click": "nyx-weather --toggle",
    "on-click-right": "nyx-weather --section settings",
    "tooltip": true
  }
}
